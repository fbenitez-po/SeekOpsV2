# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seekops"

# JWT
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambiar_este_refresh_secreto_en_produccion
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# SMTP (email - configurar en produccion)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@seekglobal.co

# Frontend URL (para links en emails)
FRONTEND_URL=http://localhost:5173

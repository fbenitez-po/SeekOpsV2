# Base de datos (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seekops

# JWT
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambiar_este_refresh_secreto_en_produccion
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# Nivel de logging: fatal | error | warn | info | debug | trace | silent (default: info).
# En NODE_ENV=test el logging queda silenciado automáticamente.
LOG_LEVEL=info

# Prefijo / versionado de la API (todas las rutas de negocio se montan bajo este path).
# Configurable por entorno; ej. /seekops/api/v1 detrás de un gateway compartido.
# /health queda fuera del prefijo.
API_PREFIX=/api/v1

# Frontend URL (para CORS y links en emails)
FRONTEND_URL=http://localhost:5173

# SMTP (email — opcional; si no está configurado los links se imprimen en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@seekglobal.co
